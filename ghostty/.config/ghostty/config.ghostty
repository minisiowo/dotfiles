# font-family = JetBrainsMono NFM
font-family = "IosevkaTerm Nerd Font Mono"
font-style = Medium
font-size = 11

theme = Kanagawa Dragon
background = #161616
# foreground = ffffff

window-padding-x = 12,12
window-padding-y = 10,10

cursor-style = block
shell-integration-features = no-cursor
cursor-style-blink = false
