prefer-no-csd

// Programy uruchamiane razem z sesją.
spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "vicinae" "server"
spawn-sh-at-startup "swaybg -i ~/dotfiles/wallpapers/Pictures/Wallpapers/nicola_samori.png"

// Urządzenia wejściowe i podstawowe zachowanie fokusu.
input {
    keyboard {
        xkb {
            layout "pl"
            options "caps:escape"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
        scroll-method "two-finger"
        scroll-factor 0.4
    }

    mouse {
        accel-profile "flat"
    }

    trackpoint {
        natural-scroll
        accel-profile "flat"
    }

    focus-follows-mouse max-scroll-amount="10%"
}

// Monitory.
output "eDP-1" {
    mode "1920x1080@60.020"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-2" {
    mode "2560x1440@74.780"
    scale 1
    transform "normal"
    position x=1920 y=0
}

output "DP-9" {
    mode "2560x1440@74.780"
    scale 1
    transform "normal"
    position x=1920 y=0
}

output "DP-7" {
    mode "1920x1080@100"
    scale 1
}

// Układ okien, odstępy i dekoracje.
layout {
    gaps 5
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        on
        width 2
        active-color "#dac3a9"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {}
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {}

// Reguły dla konkretnych okien.
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    match title="^Picture in picture$"
    open-floating true
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^org\.telegram\.desktop$"#
    open-floating true
}

// Warstwy powłoki Noctalia.
layer-rule {
    match namespace="^noctalia-overview*"
    place-within-backdrop true
}

binds {
    // Launcher, terminal, aplikacje i overlay skrótów.
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Space repeat=false { spawn "vicinae" "toggle"; }
    Mod+Alt+V repeat=false { spawn "vicinae" "vicinae://launch/clipboard/history"; }
    Mod+Alt+B repeat=false hotkey-overlay-title="Search Raindrop bookmarks" { spawn "vicinae" "vicinae://launch/@minisiowo/raindropio/raindrop"; }

    Mod+Shift+Return hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty"; }
    Mod+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "swaylock"; }
    Mod+Shift+B hotkey-overlay-title="Open Brave Browser" { spawn "brave-origin-beta"; }
    Mod+Shift+P hotkey-overlay-title="Open Perplexity" { spawn "brave-origin-beta" "--app=https://www.perplexity.ai"; }
    Mod+Shift+G hotkey-overlay-title="Open Gemini" { spawn "brave-origin-beta" "--app=https://gemini.google.com"; }
    Mod+Shift+C hotkey-overlay-title="Open ChatGPT" { spawn "brave-origin-beta" "--app=https://www.chatgpt.com"; }
    Mod+Alt+O allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // Klawisze multimedialne i jasność.
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Podstawowe akcje okien i overview.
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    // Nawigacja i przenoszenie okien/kolumn.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+L     { focus-monitor-right; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+J     { focus-monitor-down; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }

    // Workspaces.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // Nawigacja kółkiem myszy/touchpadem.
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }
    Mod+Shift+WheelScrollRight { move-column-right; }
    Mod+Shift+WheelScrollLeft  { move-column-left; }
    Mod+Ctrl+WheelScrollRight  { focus-monitor-right; }
    Mod+Ctrl+WheelScrollLeft   { focus-monitor-left; }
    Mod+Ctrl+Shift+WheelScrollRight { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+WheelScrollLeft  { move-column-to-monitor-left; }

    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-right; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // Szybki wybór i przenoszenie na workspaces 1-9.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Zarządzanie kolumnami, rozmiarem i trybem floating.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R  { reset-window-height; }

    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F  { expand-column-to-available-width; }

    Mod+C      { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W       { toggle-column-tabbed-display; }

    // Screenshoty, nagrywanie ekranu i picker kolorów.
    Mod+Alt+S { spawn-sh "grim -g \"$(slurp -d)\" - | wl-copy --type image/png"; }
    Mod+Print repeat=false hotkey-overlay-title="Toggle screen recording with desktop audio" { spawn "/home/minis/.local/bin/screenrecord-toggle" "--with-desktop-audio"; }
    Mod+Ctrl+Print repeat=false hotkey-overlay-title="Toggle screen recording" { spawn "/home/minis/.local/bin/screenrecord-toggle"; }
    Mod+Shift+Print repeat=false hotkey-overlay-title="Toggle screen recording with desktop and microphone audio" { spawn "/home/minis/.local/bin/screenrecord-toggle" "--with-desktop-audio" "--with-microphone-audio"; }
    Mod+Alt+C { spawn-sh "hyprpicker -a"; }

    // Sesja i zasilanie.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Alt+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Alt+P { power-off-monitors; }
}

// Zmienne środowiskowe dla aplikacji.
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// Motyw/generowane kolory Noctalia.
include "./noctalia.kdl"
