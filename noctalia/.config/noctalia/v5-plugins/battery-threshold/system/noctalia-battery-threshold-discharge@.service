[Unit]
Description=Force-discharge battery %i to its configured threshold
After=upower.service
ConditionPathIsDirectory=/sys/class/power_supply/%i

[Service]
Type=simple
ExecStart=/usr/libexec/noctalia-battery-threshold-helper discharge-worker %i
ExecStopPost=/usr/libexec/noctalia-battery-threshold-helper discharge-cleanup %i
Restart=no
TimeoutStopSec=15s
RuntimeMaxSec=12h
User=root
Group=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
