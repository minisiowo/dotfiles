#!/usr/bin/python3
"""Privileged helper for the Noctalia Battery Threshold plugin.

This executable is installed root-owned at /usr/libexec.  Its command surface is
intentionally small: it validates every battery name against sysfs and never
executes caller-provided shell text.
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import signal
import stat
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path

SYSFS_ROOT = Path("/sys/class/power_supply")
STATE_DIR = Path("/var/lib/noctalia-battery-threshold")
STATE_FILE = STATE_DIR / "overrides.json"
HWDB_FILE = Path("/etc/udev/hwdb.d/61-noctalia-battery-threshold.hwdb")
RUN_DIR = Path("/run/noctalia-battery-threshold")
LOCK_FILE = STATE_DIR / "operations.lock"
UNIT_PREFIX = "noctalia-battery-threshold-discharge@"
SYSTEMD_HWDB = "/usr/bin/systemd-hwdb"
UDEVADM = "/usr/bin/udevadm"
SYSTEMCTL = "/usr/bin/systemctl"
DEVICE_RE = re.compile(r"^[A-Za-z0-9_-]+$")


class HelperError(RuntimeError):
    pass


def run(command: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=check, text=True, capture_output=True)


def require_root() -> None:
    if os.geteuid() != 0:
        raise HelperError("this command must run as root (use pkexec)")


def battery_path(native: str) -> Path:
    if not DEVICE_RE.fullmatch(native):
        raise HelperError("invalid battery name")
    path = SYSFS_ROOT / native
    if not path.exists():
        raise HelperError(f"battery {native} does not exist")
    try:
        supply_type = (path / "type").read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise HelperError(f"cannot read type for {native}") from exc
    if supply_type != "Battery":
        raise HelperError(f"power supply {native} is not a Battery")
    return path


def integer(value: str, name: str, low: int, high: int) -> int:
    if not re.fullmatch(r"[0-9]+", value):
        raise HelperError(f"{name} must be an integer")
    parsed = int(value)
    if not low <= parsed <= high:
        raise HelperError(f"{name} must be between {low} and {high}")
    return parsed


def validate_thresholds(start_raw: str, end_raw: str) -> tuple[int, int]:
    start = integer(start_raw, "start threshold", 0, 99)
    end = integer(end_raw, "end threshold", 1, 100)
    if start >= end:
        raise HelperError("start threshold must be lower than end threshold")
    return start, end


@contextmanager
def operation_lock():
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o755)
    descriptor = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def atomic_write(path: Path, content: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def load_state() -> dict[str, dict[str, int]]:
    try:
        file_stat = STATE_FILE.lstat()
    except FileNotFoundError:
        return {}
    if not stat.S_ISREG(file_stat.st_mode) or file_stat.st_uid != os.geteuid():
        raise HelperError("override state is not owned by the helper user or is not a regular file")
    try:
        payload = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise HelperError("cannot read override state") from exc
    devices = payload.get("devices", {})
    if not isinstance(devices, dict):
        raise HelperError("invalid override state")
    clean: dict[str, dict[str, int]] = {}
    for native, values in devices.items():
        if not isinstance(native, str) or not DEVICE_RE.fullmatch(native) or not isinstance(values, dict):
            raise HelperError("invalid device entry in override state")
        start, end = validate_thresholds(str(values.get("start", "")), str(values.get("end", "")))
        clean[native] = {"start": start, "end": end}
        original_start = values.get("original_start")
        original_end = values.get("original_end")
        if original_start is not None or original_end is not None:
            original_start, original_end = validate_thresholds(str(original_start), str(original_end))
            clean[native]["original_start"] = original_start
            clean[native]["original_end"] = original_end
    return clean


def save_state(devices: dict[str, dict[str, int]]) -> None:
    payload = json.dumps({"version": 1, "devices": devices}, indent=2, sort_keys=True) + "\n"
    atomic_write(STATE_FILE, payload, 0o600)


def render_hwdb(devices: dict[str, dict[str, int]]) -> str:
    lines = [
        "# Managed by the Noctalia Battery Threshold plugin.",
        "# Use the plugin's Restore system defaults action instead of editing this file.",
        "",
    ]
    for native in sorted(devices):
        values = devices[native]
        lines.extend(
            [
                f"battery:{native}:*:dmi:*",
                f" CHARGE_LIMIT={values['start']},{values['end']}",
                "",
            ]
        )
    return "\n".join(lines)


def ensure_managed_hwdb() -> None:
    try:
        file_stat = HWDB_FILE.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISREG(file_stat.st_mode) or file_stat.st_uid != 0:
        raise HelperError("managed hwdb path is not a root-owned regular file")
    try:
        first_line = HWDB_FILE.read_text(encoding="utf-8").splitlines()[0]
    except (OSError, IndexError) as exc:
        raise HelperError("cannot verify managed hwdb file") from exc
    if first_line != "# Managed by the Noctalia Battery Threshold plugin.":
        raise HelperError("refusing to replace an hwdb file not owned by this plugin")


def rebuild_hwdb(devices: dict[str, dict[str, int]]) -> None:
    ensure_managed_hwdb()
    if devices:
        atomic_write(HWDB_FILE, render_hwdb(devices), 0o644)
    else:
        try:
            HWDB_FILE.unlink()
        except FileNotFoundError:
            pass
    run([SYSTEMD_HWDB, "update"])


def trigger(native: str) -> None:
    path = battery_path(native)
    run([UDEVADM, "trigger", "--action=change", str(path)])
    run([UDEVADM, "settle"], check=False)


def current_hwdb_limit(native: str) -> tuple[int, int] | None:
    path = battery_path(native)
    result = run([UDEVADM, "info", "--query=property", "--path", str(path)], check=False)
    if result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        if line.startswith("CHARGE_LIMIT="):
            match = re.fullmatch(r"CHARGE_LIMIT=([0-9]+),([0-9]+)", line)
            if match:
                return validate_thresholds(match.group(1), match.group(2))
    return None


def write_sysfs_thresholds(native: str, start: int, end: int) -> None:
    path = battery_path(native)
    start_file = path / "charge_control_start_threshold"
    end_file = path / "charge_control_end_threshold"
    if not start_file.exists() or not end_file.exists():
        raise HelperError(f"{native} does not expose writable charge thresholds")
    try:
        current_start = int(start_file.read_text(encoding="ascii").strip())
    except (OSError, ValueError) as exc:
        raise HelperError(f"cannot read current thresholds for {native}") from exc
    # Preserve start < end throughout the transition for drivers that validate
    # each write independently.
    if end <= current_start:
        start_file.write_text(f"{start}\n", encoding="ascii")
        end_file.write_text(f"{end}\n", encoding="ascii")
    else:
        end_file.write_text(f"{end}\n", encoding="ascii")
        start_file.write_text(f"{start}\n", encoding="ascii")


def refresh_upower() -> None:
    run([SYSTEMCTL, "try-restart", "upower.service"], check=False)


def read_sysfs_thresholds(native: str) -> tuple[int, int]:
    path = battery_path(native)
    try:
        start = (path / "charge_control_start_threshold").read_text(encoding="ascii").strip()
        end = (path / "charge_control_end_threshold").read_text(encoding="ascii").strip()
    except OSError as exc:
        raise HelperError(f"cannot read current thresholds for {native}") from exc
    return validate_thresholds(start, end)


def apply(native: str, start_raw: str, end_raw: str) -> None:
    battery_path(native)
    start, end = validate_thresholds(start_raw, end_raw)
    with operation_lock():
        previous = load_state()
        updated = {key: dict(value) for key, value in previous.items()}
        old_entry = previous.get(native)
        if old_entry and "original_start" in old_entry and "original_end" in old_entry:
            original_start = old_entry["original_start"]
            original_end = old_entry["original_end"]
        else:
            original_start, original_end = read_sysfs_thresholds(native)
        updated[native] = {
            "start": start,
            "end": end,
            "original_start": original_start,
            "original_end": original_end,
        }
        try:
            rebuild_hwdb(updated)
            trigger(native)
            write_sysfs_thresholds(native, start, end)
            save_state(updated)
        except Exception:
            rebuild_hwdb(previous)
            trigger(native)
            save_state(previous)
            raise
        refresh_upower()
    print(f"applied {start},{end} to {native}")


def reset(native: str) -> None:
    battery_path(native)
    with operation_lock():
        previous = load_state()
        updated = {key: dict(value) for key, value in previous.items()}
        updated.pop(native, None)
        try:
            rebuild_hwdb(updated)
            trigger(native)
            defaults = current_hwdb_limit(native)
            previous_entry = previous.get(native, {})
            if defaults is None and "original_start" in previous_entry and "original_end" in previous_entry:
                defaults = (previous_entry["original_start"], previous_entry["original_end"])
            if defaults is None:
                raise HelperError("no system or recorded original thresholds are available")
            write_sysfs_thresholds(native, *defaults)
            save_state(updated)
        except Exception:
            rebuild_hwdb(previous)
            trigger(native)
            save_state(previous)
            raise
        refresh_upower()
    print(f"restored system defaults for {native}")


def behaviour_path(native: str) -> Path:
    path = battery_path(native) / "charge_behaviour"
    try:
        modes = path.read_text(encoding="ascii").strip()
    except OSError as exc:
        raise HelperError(f"{native} does not expose charge_behaviour") from exc
    if "force-discharge" not in modes:
        raise HelperError(f"{native} does not support force-discharge")
    return path


def set_auto(native: str) -> None:
    path = battery_path(native) / "charge_behaviour"
    if path.exists():
        path.write_text("auto\n", encoding="ascii")


def target_file(native: str) -> Path:
    return RUN_DIR / f"{native}.target"


def discharge_start(native: str, target_raw: str) -> None:
    behaviour_path(native)
    target = integer(target_raw, "discharge target", 1, 100)
    unit = f"{UNIT_PREFIX}{native}.service"
    active = run([SYSTEMCTL, "is-active", "--quiet", unit], check=False)
    if active.returncode == 0:
        raise HelperError(f"force-discharge is already active for {native}")
    capacity = integer((battery_path(native) / "capacity").read_text().strip(), "capacity", 0, 100)
    if capacity <= target:
        raise HelperError(f"battery is already at or below {target}%")
    RUN_DIR.mkdir(parents=True, exist_ok=True, mode=0o755)
    atomic_write(target_file(native), f"{target}\n", 0o600)
    run([SYSTEMCTL, "start", unit])
    print(f"started force-discharge for {native} to {target}%")


def discharge_stop(native: str) -> None:
    battery_path(native)
    run([SYSTEMCTL, "stop", f"{UNIT_PREFIX}{native}.service"], check=False)
    set_auto(native)
    try:
        target_file(native).unlink()
    except FileNotFoundError:
        pass
    print(f"stopped force-discharge for {native}")


def discharge_cleanup(native: str) -> None:
    battery_path(native)
    set_auto(native)
    try:
        target_file(native).unlink()
    except FileNotFoundError:
        pass


def discharge_worker(native: str) -> None:
    behaviour = behaviour_path(native)
    target_path = target_file(native)
    try:
        target = integer(target_path.read_text().strip(), "discharge target", 1, 100)
    except OSError as exc:
        raise HelperError("discharge target is missing") from exc
    stopping = False

    def stop(_signum: int, _frame: object) -> None:
        nonlocal stopping
        stopping = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    behaviour.write_text("force-discharge\n", encoding="ascii")
    try:
        while not stopping:
            capacity = integer((battery_path(native) / "capacity").read_text().strip(), "capacity", 0, 100)
            if capacity <= target:
                break
            time.sleep(30)
    finally:
        set_auto(native)
        try:
            target_path.unlink()
        except FileNotFoundError:
            pass


def usage() -> str:
    return (
        "usage: noctalia-battery-threshold-helper "
        "apply DEVICE START END | reset DEVICE | discharge-start DEVICE TARGET | "
        "discharge-stop DEVICE | discharge-worker DEVICE | discharge-cleanup DEVICE"
    )


def main(argv: list[str]) -> int:
    try:
        require_root()
        if len(argv) == 5 and argv[1] == "apply":
            apply(argv[2], argv[3], argv[4])
        elif len(argv) == 3 and argv[1] == "reset":
            reset(argv[2])
        elif len(argv) == 4 and argv[1] == "discharge-start":
            discharge_start(argv[2], argv[3])
        elif len(argv) == 3 and argv[1] == "discharge-stop":
            discharge_stop(argv[2])
        elif len(argv) == 3 and argv[1] == "discharge-worker":
            discharge_worker(argv[2])
        elif len(argv) == 3 and argv[1] == "discharge-cleanup":
            discharge_cleanup(argv[2])
        else:
            raise HelperError(usage())
    except (HelperError, OSError, subprocess.CalledProcessError) as exc:
        print(f"battery-threshold-helper: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
